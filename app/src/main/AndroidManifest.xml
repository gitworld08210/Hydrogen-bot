<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions for Voice, Network, Hardware & Security -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Package queries for Native App Detection (Android 11+) -->
    <queries>
        <!-- Speech Recognition Service & Voice Intent Queries (Mandatory for Android 11+) -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <!-- Universal Launcher Query: Discover and launch any app installed on the device -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="spotify" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="zomato" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="swiggy" />
        </intent>
        <package android:name="com.google.android.googlequicksearchbox" />

        <!-- Amazon Native Apps -->
        <package android:name="in.amazon.mShop.android.shopping" />
        <package android:name="com.amazon.mShop.android.shopping" />
        <!-- YouTube Native App -->
        <package android:name="com.google.android.youtube" />
        <!-- Flipkart Native App -->
        <package android:name="com.flipkart.android" />
        <!-- WhatsApp Native App -->
        <package android:name="com.whatsapp" />
        <!-- Blinkit Native App -->
        <package android:name="com.grofers.customerapp" />
        <!-- IRCTC Rail Connect Native App -->
        <package android:name="cris.org.in.prs.ima" />
        <!-- Cab Apps -->
        <package android:name="com.ubercab" />
        <package android:name="com.olacabs.customer" />
    </queries>

    <application
        android:name=".HydrogenApp"
        android:allowBackup="true"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/ic_btn_speak_now"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Firebase Cloud Messaging (FCM) Service for Push Notifications -->
        <service
            android:name=".notification.HydrogenMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Hydrogen JARVIS Autonomous Accessibility Service -->
        <service
            android:name=".services.HydrogenAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Floating JARVIS Overlay HUD Service -->
        <service
            android:name=".services.FloatingJarvisService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating JARVIS Phone Controller HUD" />
        </service>
        <!-- Hydrogen Notification Listener Service for WhatsApp / Instagram Auto-Chat -->
        <service
            android:name=".notification.HydrogenNotificationListener"
            android:label="Hydrogen Auto-Chat Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
