<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions for Voice, Network, Hardware & Security -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package queries for Native App Detection (Android 11+) -->
    <queries>
        <!-- Amazon Native Apps -->
        <package android:name="in.amazon.mShop.android.shopping" />
        <package android:name="com.amazon.mShop.android.shopping" />
        <!-- YouTube Native App -->
        <package android:name="com.google.android.youtube" />
        <!-- Flipkart Native App -->
        <package android:name="com.flipkart.android" />
        <!-- WhatsApp Native App -->
        <package android:name="com.whatsapp" />
        <!-- Blinkit Native App -->
        <package android:name="com.grofers.customerapp" />
        <!-- IRCTC Rail Connect Native App -->
        <package android:name="cris.org.in.prs.ima" />
        <!-- Cab Apps -->
        <package android:name="com.ubercab" />
        <package android:name="com.olacabs.customer" />
    </queries>

    <application
        android:name=".HydrogenApp"
        android:allowBackup="true"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/ic_btn_speak_now"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Firebase Cloud Messaging (FCM) Service for Push Notifications -->
        <service
            android:name=".notification.HydrogenMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
